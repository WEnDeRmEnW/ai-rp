{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": [
    "server/**/*.test.ts",
    "server/live-turn-smoke.ts",
    "server/live-upgrade-smoke.ts",
    "server/live-artifact-smoke.ts",
    "shared/**/*.test.ts"
  ]
}

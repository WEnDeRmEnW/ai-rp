# Runtime and persistent account storage.
PORT=8787
LETOPIS_DATA_DIR=.data
PUBLIC_URL=http://127.0.0.1:8787

# Optional server-side model defaults. Keys entered in the UI stay in sessionStorage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional cheaper/faster model for auxiliary service-stage calls (context selection,
# classification and other bounded JSON utilities). Leave empty to always use the main model.
LETOPIS_SERVICE_MODEL=

# Optional Google OAuth. Callback: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time secret used to appoint the first owner/admin account.
ADMIN_BOOTSTRAP_TOKEN=
